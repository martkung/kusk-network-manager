{
  "name": "networkmanager-agent",
  "version": "1.0.0",
  "description": "Network Switch Ping Agent",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "test:security": "node --experimental-vm-modules --test --test-concurrency=1 security-test/*.test.mjs",
    "security:remove-credentials": "node remove-legacy-credentials.js",
    "security:migrate-private-data": "node migrate-private-switch-data.js",
    "security:configure-storage-cors": "node configure-storage-cors.js",
    "security:sync-users": "node sync-auth-users.js",
    "security:sync-public-switches": "node sync-public-switches.js",
    "security:verify-roles": "node verify-role-rules.js",
    "security:verify-status": "node verify-status-monitoring.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "ping": "^0.4.4"
  },
  "overrides": {
    "uuid": "11.1.1",
    "@grpc/grpc-js": "1.14.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.9.1"
  }
}
