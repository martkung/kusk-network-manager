rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        request.auth.uid == 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1';
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return isOwner()
        ? 'owner'
        : (hasProfile()
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : 'default');
    }

    function canViewInventory() {
      return currentRole() in ['owner', 'admin', 'editor', 'viewer'];
    }

    function canEditNetwork() {
      return currentRole() in ['owner', 'admin', 'editor'];
    }

    function canManageUsers() {
      return currentRole() in ['owner', 'admin'];
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validImagePath(path) {
      return path == '' ||
        path.matches('^device-images/[^/]+/[^/]+$');
    }

    function validIpv4(value) {
      return value.matches(
        '^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}' +
        '(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$'
      );
    }

    function validPublicSwitch(data) {
      return data.keys().hasOnly([
          'name',
          'brand',
          'model',
          'location',
          'status',
          'lastSeen',
          'mainImage',
          'galleryImages',
          'auditId',
          'lifecycleId'
        ]) &&
        optionalString(data, 'auditId', 100) &&
        optionalString(data, 'lifecycleId', 100) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        optionalString(data, 'brand', 100) &&
        optionalString(data, 'model', 100) &&
        optionalString(data, 'location', 200) &&
        data.status in ['online', 'offline'] &&
        (!('lastSeen' in data) ||
          (data.lastSeen is string && data.lastSeen.size() <= 100) ||
          data.lastSeen is timestamp) &&
        (!('mainImage' in data) ||
          (data.mainImage is string &&
            data.mainImage.size() <= 500 &&
            validImagePath(data.mainImage))) &&
        (!('galleryImages' in data) ||
          (data.galleryImages is list && data.galleryImages.size() <= 20));
    }

    function validPrivateSwitch(data) {
      return data.keys().hasOnly([
          'ip',
          'mac',
          'serialNumber',
          'configUrl'
        ]) &&
        data.ip is string &&
        validIpv4(data.ip) &&
        data.mac is string &&
        (data.mac == '' ||
          data.mac.matches('^([0-9A-F]{2}:){5}[0-9A-F]{2}$')) &&
        optionalString(data, 'serialNumber', 100) &&
        data.configUrl is string &&
        data.configUrl == 'http://' + data.ip;
    }

    function validGuestSwitch(data) {
      return data.keys().hasOnly([
          'brand',
          'model',
          'status',
          'lastSeen'
        ]) &&
        data.brand is string &&
        data.brand.size() <= 100 &&
        data.model is string &&
        data.model.size() <= 100 &&
        data.status in ['online', 'offline'] &&
        ((data.lastSeen is string && data.lastSeen.size() <= 100) ||
          data.lastSeen is timestamp);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'role',
          'createdAt',
          'lastLoginAt',
          'roleUpdatedAt',
          'roleUpdatedBy'
        ]) &&
        data.email is string &&
        data.email.size() <= 254 &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.photoURL is string &&
        data.photoURL.size() <= 1000 &&
        data.role in ['owner', 'admin', 'editor', 'viewer', 'default'] &&
        optionalTimestamp(data, 'createdAt') &&
        optionalTimestamp(data, 'lastLoginAt') &&
        optionalTimestamp(data, 'roleUpdatedAt') &&
        optionalString(data, 'roleUpdatedBy', 128);
    }

    function isOwnDefaultProfile(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == 'default' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid;
    }

    function isOwnSafeProfileUpdate(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'lastLoginAt'
        ]);
    }

    function managerCanCreateRole(userId, role) {
      return userId != 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1' &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid &&
        ((isOwner() && role in ['admin', 'editor', 'viewer', 'default']) ||
        (currentRole() == 'admin' &&
          role in ['editor', 'viewer', 'default']));
    }

    function managerCanUpdateRole(userId) {
      return userId != 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1' &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'roleUpdatedAt',
          'roleUpdatedBy'
        ]) &&
        ((isOwner() &&
          resource.data.role != 'owner' &&
          request.resource.data.role in ['admin', 'editor', 'viewer', 'default']) ||
        (currentRole() == 'admin' &&
          resource.data.role in ['editor', 'viewer', 'default'] &&
          request.resource.data.role in ['editor', 'viewer', 'default']));
    }

    // Every browser mutation must create its immutable receipt in the same commit.
    function freshDeviceAudit(deviceId, eventId, actions) {
      let path = /databases/$(database)/documents/deviceAudit/$(eventId);
      let audit = getAfter(path).data;
      return eventId is string && eventId.matches('^[A-Za-z0-9_-]{1,100}$') &&
        !exists(path) && audit.deviceId == deviceId && audit.action in actions &&
        audit.actorUid == request.auth.uid && audit.occurredAt == request.time;
    }

    function finalDeviceAudit(deviceId) {
      return getAfter(/databases/$(database)/documents/switches/$(deviceId)).data.auditId;
    }

    function deletedDeviceAudit(deviceId) {
      return getAfter(/databases/$(database)/documents/deviceTrash/$(deviceId)).data.auditId;
    }

    function guestMatchesDevice(deviceId, data) {
      let device = getAfter(/databases/$(database)/documents/switches/$(deviceId)).data;
      return validGuestSwitch(data) && data.brand == device.brand &&
        data.model == device.model && data.status == device.status && data.lastSeen == device.lastSeen;
    }

    function auditFinalInventory(audit, eventId) {
      return validPublicSwitch(audit.after) && validPrivateSwitch(audit.privateAfter) &&
        deviceImagePaths(audit.deviceId, audit.after) &&
        audit.after.auditId == eventId &&
        getAfter(/databases/$(database)/documents/switches/$(audit.deviceId)).data == audit.after &&
        getAfter(/databases/$(database)/documents/switchPrivate/$(audit.deviceId)).data == audit.privateAfter &&
        guestMatchesDevice(audit.deviceId,
          getAfter(/databases/$(database)/documents/publicSwitches/$(audit.deviceId)).data);
    }

    function deviceImagePaths(deviceId, data) {
      return (!('mainImage' in data) || data.mainImage == '' ||
          data.mainImage.matches('^device-images/' + deviceId + '/[^/]+$')) &&
        (!('galleryImages' in data) || data.galleryImages.size() == 0 ||
          data.galleryImages.join('|').matches('^device-images/' + deviceId + '/[^/|]+([|]device-images/' + deviceId + '/[^/|]+)*$'));
    }

    function auditOriginalInventory(audit) {
      return get(/databases/$(database)/documents/switches/$(audit.deviceId)).data == audit.before &&
        get(/databases/$(database)/documents/switchPrivate/$(audit.deviceId)).data == audit.privateBefore;
    }

    function auditNewDevice(audit, eventId) {
      return audit.action == 'create' && audit.before == null && audit.privateBefore == null &&
        audit.sourceEventId == '' && audit.after.lifecycleId == eventId && audit.after.lastSeen == '' &&
        !exists(/databases/$(database)/documents/switches/$(audit.deviceId)) &&
        !exists(/databases/$(database)/documents/switchPrivate/$(audit.deviceId)) &&
        !exists(/databases/$(database)/documents/deviceTrash/$(audit.deviceId)) &&
        auditFinalInventory(audit, eventId);
    }

    function auditEditedDevice(audit, eventId) {
      return audit.action == 'update' && audit.sourceEventId == '' &&
        auditOriginalInventory(audit) && auditFinalInventory(audit, eventId) &&
        audit.after.get('lifecycleId', '') == audit.before.get('lifecycleId', '') &&
        ((audit.privateAfter.ip == audit.privateBefore.ip && audit.after.status == audit.before.status &&
            audit.after.lastSeen == audit.before.get('lastSeen', '')) || audit.after.lastSeen == '');
    }

    function auditDeletedDevice(audit, eventId) {
      return audit.action == 'delete' && audit.after == null && audit.privateAfter == null &&
        audit.sourceEventId == '' && audit.reason.size() > 0 && auditOriginalInventory(audit) &&
        !exists(/databases/$(database)/documents/deviceTrash/$(audit.deviceId)) &&
        !existsAfter(/databases/$(database)/documents/switches/$(audit.deviceId)) &&
        !existsAfter(/databases/$(database)/documents/switchPrivate/$(audit.deviceId)) &&
        !existsAfter(/databases/$(database)/documents/publicSwitches/$(audit.deviceId)) &&
        getAfter(/databases/$(database)/documents/deviceTrash/$(audit.deviceId)).data == {
          'deviceId': audit.deviceId, 'device': audit.before, 'privateDevice': audit.privateBefore,
          'deletedAt': request.time, 'deletedBy': request.auth.uid, 'deletedByEmail': audit.actorEmail,
          'reason': audit.reason, 'auditId': eventId
        };
    }

    function auditRestoredDevice(audit, eventId) {
      let trash = get(/databases/$(database)/documents/deviceTrash/$(audit.deviceId)).data;
      return audit.action == 'restore' && canManageUsers() &&
        audit.before == null && audit.privateBefore == null && audit.sourceEventId == trash.auditId &&
        !exists(/databases/$(database)/documents/switches/$(audit.deviceId)) &&
        !exists(/databases/$(database)/documents/switchPrivate/$(audit.deviceId)) &&
        !existsAfter(/databases/$(database)/documents/deviceTrash/$(audit.deviceId)) &&
        audit.after.diff(trash.device).affectedKeys().hasOnly(['auditId', 'lifecycleId', 'status', 'lastSeen']) &&
        audit.after.lifecycleId == eventId && audit.after.status == 'offline' && audit.after.lastSeen == '' &&
        audit.privateAfter == trash.privateDevice && auditFinalInventory(audit, eventId);
    }

    match /deviceAudit/{eventId} {
      allow read: if signedIn() && canEditNetwork();
      allow create: if signedIn() && canEditNetwork() &&
        request.resource.data.keys().hasOnly(['deviceId', 'action', 'actorUid', 'actorEmail', 'occurredAt',
          'reason', 'before', 'after', 'privateBefore', 'privateAfter', 'sourceEventId']) &&
        request.resource.data.deviceId is string &&
        request.resource.data.deviceId.matches('^[A-Za-z0-9_-]{1,200}$') &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.get('email', '') &&
        request.resource.data.occurredAt == request.time &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 200 &&
        (request.resource.data.action == 'create' ? auditNewDevice(request.resource.data, eventId) :
          request.resource.data.action == 'update' ? auditEditedDevice(request.resource.data, eventId) :
          request.resource.data.action == 'delete' ? auditDeletedDevice(request.resource.data, eventId) :
          request.resource.data.action == 'restore' && auditRestoredDevice(request.resource.data, eventId));
      allow update, delete: if false;
    }

    match /deviceTrash/{deviceId} {
      allow read: if signedIn() && canEditNetwork();
      allow create: if signedIn() && canEditNetwork() &&
        freshDeviceAudit(deviceId, request.resource.data.auditId, ['delete']);
      allow update: if false;
      allow delete: if signedIn() && canManageUsers() &&
        freshDeviceAudit(deviceId, finalDeviceAudit(deviceId), ['restore']);
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || canManageUsers());
      allow list: if canManageUsers();
      allow create: if signedIn() &&
        validUserProfile(request.resource.data) &&
        (isOwnDefaultProfile(userId) ||
          (canManageUsers() &&
            managerCanCreateRole(userId, request.resource.data.role)));
      allow update: if signedIn() &&
        validUserProfile(request.resource.data) &&
        (isOwnSafeProfileUpdate(userId) ||
          (canManageUsers() && managerCanUpdateRole(userId)));
      allow delete: if false;
    }

    match /switches/{switchId} {
      allow read: if signedIn() && canViewInventory();
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        validPublicSwitch(request.resource.data) &&
        freshDeviceAudit(switchId, request.resource.data.auditId, ['create', 'update', 'restore']);
      allow delete: if signedIn() && canEditNetwork() &&
        freshDeviceAudit(switchId, deletedDeviceAudit(switchId), ['delete']);
    }

    match /publicSwitches/{switchId} {
      allow read: if true;
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        guestMatchesDevice(switchId, request.resource.data) &&
        freshDeviceAudit(switchId, finalDeviceAudit(switchId), ['create', 'update', 'restore']);
      allow delete: if signedIn() && canEditNetwork() &&
        freshDeviceAudit(switchId, deletedDeviceAudit(switchId), ['delete']);
    }

    match /switchPrivate/{switchId} {
      allow read: if signedIn() && canEditNetwork();
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        validPrivateSwitch(request.resource.data) &&
        freshDeviceAudit(switchId, finalDeviceAudit(switchId), ['create', 'update', 'restore']);
      allow delete: if signedIn() && canEditNetwork() &&
        freshDeviceAudit(switchId, deletedDeviceAudit(switchId), ['delete']);
    }

    match /networkLinks/{linkId} {
      allow read: if signedIn() && canEditNetwork();
      allow write: if false;
    }

    match /accesspoints/{accessPointId} {
      allow read: if signedIn() && canViewInventory();
      allow write: if false;
    }

    match /monitoring/networkAgent {
      allow get: if signedIn() && canViewInventory();
      allow list, write: if false;
    }

    match /statusHistory/{eventId} {
      allow read: if signedIn() && canViewInventory();
      allow write: if false;
    }

    match /networkIncidents/{incidentId} {
      allow read: if signedIn() && canViewInventory();
      allow create, delete: if false;
      allow update: if signedIn() && canEditNetwork() &&
        resource.data.status == 'open' &&
        resource.data.acknowledgedAt == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'acknowledgedAt', 'acknowledgedBy'
        ]) &&
        request.resource.data.acknowledgedAt == request.time &&
        request.resource.data.acknowledgedBy == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
