rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        request.auth.uid == 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1';
    }

    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return isOwner()
        ? 'owner'
        : (hasProfile()
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          : 'default');
    }

    function canViewInventory() {
      return currentRole() in ['owner', 'admin', 'editor', 'viewer'];
    }

    function canEditNetwork() {
      return currentRole() in ['owner', 'admin', 'editor'];
    }

    function canManageUsers() {
      return currentRole() in ['owner', 'admin'];
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validImagePath(path) {
      return path == '' ||
        path.matches('^device-images/[^/]+/[^/]+$');
    }

    function validIpv4(value) {
      return value.matches(
        '^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}' +
        '(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$'
      );
    }

    function validPublicSwitch(data) {
      return data.keys().hasOnly([
          'name',
          'brand',
          'model',
          'location',
          'status',
          'lastSeen',
          'mainImage',
          'galleryImages'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        optionalString(data, 'brand', 100) &&
        optionalString(data, 'model', 100) &&
        optionalString(data, 'location', 200) &&
        data.status in ['online', 'offline'] &&
        (!('lastSeen' in data) ||
          (data.lastSeen is string && data.lastSeen.size() <= 100) ||
          data.lastSeen is timestamp) &&
        (!('mainImage' in data) ||
          (data.mainImage is string &&
            data.mainImage.size() <= 500 &&
            validImagePath(data.mainImage))) &&
        (!('galleryImages' in data) ||
          (data.galleryImages is list && data.galleryImages.size() <= 20));
    }

    function validPrivateSwitch(data) {
      return data.keys().hasOnly([
          'ip',
          'mac',
          'serialNumber',
          'configUrl'
        ]) &&
        data.ip is string &&
        validIpv4(data.ip) &&
        data.mac is string &&
        (data.mac == '' ||
          data.mac.matches('^([0-9A-F]{2}:){5}[0-9A-F]{2}$')) &&
        optionalString(data, 'serialNumber', 100) &&
        data.configUrl is string &&
        data.configUrl == 'http://' + data.ip;
    }

    function validGuestSwitch(data) {
      return data.keys().hasOnly([
          'brand',
          'model',
          'status',
          'lastSeen'
        ]) &&
        data.brand is string &&
        data.brand.size() <= 100 &&
        data.model is string &&
        data.model.size() <= 100 &&
        data.status in ['online', 'offline'] &&
        ((data.lastSeen is string && data.lastSeen.size() <= 100) ||
          data.lastSeen is timestamp);
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'role',
          'createdAt',
          'lastLoginAt',
          'roleUpdatedAt',
          'roleUpdatedBy'
        ]) &&
        data.email is string &&
        data.email.size() <= 254 &&
        data.displayName is string &&
        data.displayName.size() <= 120 &&
        data.photoURL is string &&
        data.photoURL.size() <= 1000 &&
        data.role in ['owner', 'admin', 'editor', 'viewer', 'default'] &&
        optionalTimestamp(data, 'createdAt') &&
        optionalTimestamp(data, 'lastLoginAt') &&
        optionalTimestamp(data, 'roleUpdatedAt') &&
        optionalString(data, 'roleUpdatedBy', 128);
    }

    function isOwnDefaultProfile(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == 'default' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid;
    }

    function isOwnSafeProfileUpdate(userId) {
      return request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'lastLoginAt'
        ]);
    }

    function managerCanCreateRole(userId, role) {
      return userId != 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1' &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid &&
        ((isOwner() && role in ['admin', 'editor', 'viewer', 'default']) ||
        (currentRole() == 'admin' &&
          role in ['editor', 'viewer', 'default']));
    }

    function managerCanUpdateRole(userId) {
      return userId != 'Bnnm2NUV8rUQ0Am2NxBuJxnCxFi1' &&
        request.resource.data.roleUpdatedAt == request.time &&
        request.resource.data.roleUpdatedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'roleUpdatedAt',
          'roleUpdatedBy'
        ]) &&
        ((isOwner() &&
          resource.data.role != 'owner' &&
          request.resource.data.role in ['admin', 'editor', 'viewer', 'default']) ||
        (currentRole() == 'admin' &&
          resource.data.role in ['editor', 'viewer', 'default'] &&
          request.resource.data.role in ['editor', 'viewer', 'default']));
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || canManageUsers());
      allow list: if canManageUsers();
      allow create: if signedIn() &&
        validUserProfile(request.resource.data) &&
        (isOwnDefaultProfile(userId) ||
          (canManageUsers() &&
            managerCanCreateRole(userId, request.resource.data.role)));
      allow update: if signedIn() &&
        validUserProfile(request.resource.data) &&
        (isOwnSafeProfileUpdate(userId) ||
          (canManageUsers() && managerCanUpdateRole(userId)));
      allow delete: if false;
    }

    match /switches/{switchId} {
      allow read: if signedIn() && canViewInventory();
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        validPublicSwitch(request.resource.data);
      allow delete: if signedIn() && canEditNetwork();
    }

    match /publicSwitches/{switchId} {
      allow read: if true;
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        validGuestSwitch(request.resource.data);
      allow delete: if signedIn() && canEditNetwork();
    }

    match /switchPrivate/{switchId} {
      allow read: if signedIn() && canEditNetwork();
      allow create, update: if signedIn() &&
        canEditNetwork() &&
        validPrivateSwitch(request.resource.data);
      allow delete: if signedIn() && canEditNetwork();
    }

    match /networkLinks/{linkId} {
      allow read: if signedIn() && canEditNetwork();
      allow write: if false;
    }

    match /accesspoints/{accessPointId} {
      allow read: if signedIn() && canViewInventory();
      allow write: if false;
    }

    match /monitoring/networkAgent {
      allow get: if signedIn() && canViewInventory();
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
